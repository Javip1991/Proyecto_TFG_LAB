<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CyberLab - Diccionario</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">CYBER<span>//</span>LAB</a>
      <div class="nav-links">
        <a href="/">INICIO</a>
        <a href="/#labs">LABORATORIOS</a>
        <a href="/Diccionario" class="active">DICCIONARIO</a>
      </div>
    </nav>

    <section class="hero" style="padding-bottom: 2rem">
      <div class="hero-tag">REFERENCIA</div>
      <h1>Diccionario de<br /><em>Ciberseguridad</em></h1>
      <p>
        Conceptos, vulnerabilidades y tipos de ataque explicados de forma clara.
        Una referencia para entender el mundo de la seguridad informática.
      </p>

      <!-- Buscador -->
      <div style="margin-top: 2rem">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar concepto..."
          style="
            background: transparent;
            border: 1px solid var(--accent);
            color: var(--text);
            font-family: &quot;Share Tech Mono&quot;, monospace;
            font-size: 1rem;
            padding: 0.6rem 1.2rem;
            width: 100%;
            max-width: 420px;
            outline: none;
          "
        />
      </div>

      <!-- Filtros por categoría -->
      <div
        id="filter-buttons"
        style="
          margin-top: 1.2rem;
          display: flex;
          gap: 0.6rem;
          flex-wrap: wrap;
          justify-content: center;
        "
      ></div>
    </section>

    <section class="labs-section">
      <div class="section-header">
        <h2>// Conceptos y ataques</h2>
      </div>
      <div id="dict-root"></div>
    </section>

    <a href="/" class="btn">Volver</a>

    <footer>
      <span>CYBERLAB Javier Perea Gómez © 2026</span>
      <span>SOLO USO EDUCATIVO - HAPPY HACKING</span>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
    <script src="/js/dictionary.js"></script>
  </body>
</html>
